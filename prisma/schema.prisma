generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model migrations {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("_migrations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asset {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug             String             @unique
  name             String
  category_id      String
  type             String
  variant          String?
  file_path        String
  format           String
  size_bytes       Int
  width            Int?
  height           Int?
  duration_ms      Int?
  frames           Int?
  inline_rig       Boolean            @default(false)
  sha256           String
  tags             String[]           @default([])
  status           String             @default("ACTIVE")
  source           String             @default("UPLOAD")
  version          Int                @default(1)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  asset_category   asset_category     @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  game_asset_usage game_asset_usage[]
  vocabulary_asset vocabulary_asset[]

  @@index([category_id, status], map: "asset_category_status_idx")
  @@index([sha256])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asset_category {
  id                   String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                 String
  slug                 String           @unique
  grp                  String
  parent_id            String?
  asset                asset[]
  asset_category       asset_category?  @relation("asset_categoryToasset_category", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_asset_category asset_category[] @relation("asset_categoryToasset_category")
}

model game_asset_usage {
  id       String @id @default(dbgenerated("(gen_random_uuid())::text"))
  game_key String
  asset_id String
  role     String
  asset    asset  @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([game_key, asset_id, role])
  @@index([asset_id], map: "game_asset_usage_asset_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model vocabulary {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  word                String
  slug                String                @unique
  category_id         String
  part_of_speech      String?
  definition          String?
  example             String?
  translation         String?
  plural              String?
  sound_text          String?
  difficulty          Int                   @default(1)
  tags                String[]              @default([])
  syllables           Int?
  word_length         Int
  first_letter        String
  status              String                @default("ACTIVE")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  vocabulary_category vocabulary_category   @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabulary_asset    vocabulary_asset[]
  vocabulary_set_item vocabulary_set_item[]

  @@index([category_id], map: "vocabulary_category_idx")
  @@index([first_letter])
}

model vocabulary_asset {
  vocabulary_id String
  asset_id      String
  role          String
  is_primary    Boolean    @default(false)
  sort_order    Int        @default(0)
  asset         asset      @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabulary    vocabulary @relation(fields: [vocabulary_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([vocabulary_id, asset_id, role])
  @@index([asset_id], map: "vocabulary_asset_asset_idx")
}

model vocabulary_category {
  id                        String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                      String
  slug                      String                @unique
  parent_id                 String?
  vocabulary                vocabulary[]
  vocabulary_category       vocabulary_category?  @relation("vocabulary_categoryTovocabulary_category", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_vocabulary_category vocabulary_category[] @relation("vocabulary_categoryTovocabulary_category")
}

model vocabulary_set {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                String                @unique
  description         String?
  level               String?
  published           Boolean               @default(false)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  vocabulary_set_item vocabulary_set_item[]
}

model vocabulary_set_item {
  set_id         String
  vocabulary_id  String
  sort_order     Int            @default(0)
  vocabulary_set vocabulary_set @relation(fields: [set_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vocabulary     vocabulary     @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([set_id, vocabulary_id])
}
