# Untuk tes di komputer: salin jadi .env.local. Di Railway isi lewat menu Variables.
ACCESS_CODE=kodeawal123
ADMIN_PASSWORD=passwordoperator-yang-panjang
SESSION_SECRET=isi-dengan-teks-acak-panjang-minimal-32-karakter
DATA_DIR=./data
# Perpustakaan asset + kosakata (PostgreSQL). Di Railway: referensikan variabel dari service Postgres.
# Jika kosong, website tetap jalan dan game memakai kata bawaan.
DATABASE_URL=postgresql://user:password@localhost:5432/hiveplay
